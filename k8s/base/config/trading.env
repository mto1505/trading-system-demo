# Cấu hình chung cho cả 4 service, sinh thành ConfigMap `trading-config`.
#
# CỐ Ý dùng TÊN SERVICE NGẮN, không FQDN có namespace: DNS trong cluster tự
# gắn search domain <namespace>.svc.cluster.local, nên cùng một file này chạy
# đúng ở trading-dev / trading-staging / trading-prod mà không phải nhân bản.
KAFKA_BOOTSTRAP=kafka-0.kafka:9092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
DB_HOST=postgres
DB_PORT=5432
DB_NAME=trading
REDIS_HOST=redis

# true  = OutboxRelay polling (mặc định)
# false = khi dùng Debezium CDC; để true cả hai sẽ publish trùng event
OUTBOX_RELAY_ENABLED=true

# Tỉ lệ sample trace. 1.0 ở dev để nhìn rõ; prod hạ xuống vì trace 100%
# luồng tick tốn CPU và băng thông đáng kể trên hot path.
TRACING_PROBABILITY=0.1

# market-gateway tự sinh tick giả. Prod phải tắt và cắm feed thật.
SIMULATED_FEED=true

# Dùng bởi Job kafka-topics-init. Trần scale consumer = PARTITIONS / 3
# (concurrency của cả 3 listener factory đều là 3).
KAFKA_PARTITIONS=6
KAFKA_TOPIC_REPLICAS=1

# Retention của topic nghiệp vụ là MỘT HỢP ĐỒNG với bảng `processed_event` của
# matching-engine: job dọn processed_event phải giữ LÂU HƠN con số này. Dọn sớm
# hơn = replay từ offset cũ sẽ khớp lệnh HAI LẦN vì bản ghi chống trùng đã mất.
# 7 ngày
TOPIC_RETENTION_MS=604800000
# 30 ngày - DLT là dữ liệu chẩn đoán nên giữ lâu hơn topic nghiệp vụ
DLT_RETENTION_MS=2592000000
